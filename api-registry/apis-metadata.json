  "descriptions": [
    {
      "api_id": "api-store-location",
      "summary": "Store Location API provides store/outlet locations, opening hours, and availability for retail and partner channels.",
      "use_cases": ["Store finder", "Agent locator", "Inventory availability"],
      "target_consumers": ["Web app", "Mobile app", "Partner portals"]
    },
    {
      "api_id": "api-bank-check-balance",
      "summary": "Bank Check Balance API verifies bank accounts and returns balance for payment flows (top-up, bill pay, refunds).",
      "use_cases": ["Account verification", "Balance check before payment", "Reconciliation"],
      "target_consumers": ["Payments service", "Billing", "Partner gateways"]
    },
    {
      "api_id": "api-sim-swaps",
      "summary": "SIM Swap API supports initiating and tracking SIM swap requests with fraud and eligibility checks.",
      "use_cases": ["SIM replacement", "Device change", "Fraud detection"],
      "target_consumers": ["Care apps", "Retail POS", "Fraud systems"]
    },
    {
      "api_id": "api-customer-status",
      "summary": "Customer Status API exposes unified customer profile, account status, segment, and service eligibility.",
      "use_cases": ["Personalization", "Eligibility checks", "Dashboard", "Care"],
      "target_consumers": ["All consumer-facing apps", "CRM", "Billing"]
    },
    {
      "api_id": "api-topup",
      "summary": "Top-Up API enables prepaid airtime and data recharge, bundle purchase, and recharge history.",
      "use_cases": ["Self-care top-up", "Agent recharge", "Bundle purchase"],
      "target_consumers": ["Mobile app", "USSD", "Retail POS", "Partners"]
    }
  ]
}
