      "operation_id": "getSimSwapStatus"
    },
    {
      "id": "ep-customer-status",
      "api_version_id": "av-customer-status-v1",
      "method": "GET",
      "path": "/v2/customers/{customerId}/status",
      "summary": "Get customer account status and segment",
      "operation_id": "getCustomerStatus"
    },
    {
      "id": "ep-topup-execute",
      "api_version_id": "av-topup-v1",
      "method": "POST",
      "path": "/v1/topup",
      "summary": "Execute top-up for a subscriber",
      "operation_id": "executeTopup"
    }
